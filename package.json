{
  "name": "food-objects",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check": "astro check",
    "predeploy": "git diff --quiet HEAD && test -z \"$(git ls-files --others --exclude-standard)\" || (echo commit first && exit 1)",
    "deploy": "astro build && wrangler d1 migrations apply food-objects --remote && wrangler deploy",
    "test:unit": "bun test src",
    "test": "playwright test"
  },
  "dependencies": {
    "astro": "^7.3.8"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@biomejs/biome": "^2.5.15",
    "@playwright/test": "^1.65.0",
    "@types/bun": "^1.4.4",
    "typescript": "^6.0.3",
    "wrangler": "^4.149.0"
  }
}
